# Admin UI login (single admin)
# Admin password is compared in constant time.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google OAuth (create an OAuth 2.0 Client ID of type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# App
APP_URL=http://localhost:3000

# Public URL for the gateway API (used in S3-compatible clients) optionally
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000

# Session cookie Secure flag: 1 = always, 0 = never, unset = derive from APP_URL
COOKIE_SECURE=

# Directory for SQLite DB + temporary upload files
STORAGE_DIR=./data

# Optional DB override; defaults to $STORAGE_DIR/gateway.db
DATABASE_PATH=./data/gateway.db

# 32-byte base64 key used to encrypt refresh tokens at rest.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Account selection strategy: quota | round_robin
ACCOUNT_SELECTION_STRATEGY=quota

# Login rate limiting. Set TRUST_PROXY=1 only when the app runs behind a
# reverse proxy that overwrites X-Forwarded-For / X-Real-IP; otherwise clients
# could spoof those headers and bypass the limiter.
TRUST_PROXY=0
LOGIN_MAX_PER_IP=5
LOGIN_MAX_PER_EMAIL=20
LOGIN_WINDOW_MINUTES=1

# Failed admin-password attempts (backup/restore) per IP per window.
ADMIN_PASSWORD_MAX_ATTEMPTS=5

# Invalid API-key attempts per IP per window.
API_KEY_MAX_FAILURES=30

# Allow S3 backend endpoints on private networks (MinIO on LAN/VPC).
# Link-local and cloud metadata addresses stay blocked.
S3_ALLOW_PRIVATE_ENDPOINTS=0

# Max upload size for a single request (bytes). 524288000 = 500MB.
MAX_UPLOAD_BYTES=524288000

# S3-compatible endpoint settings
S3_REGION=us-east-1
# Max body size for a single S3 PutObject (bytes). 1073741824 = 1GB.
S3_MAX_PUT_BYTES=1073741824
